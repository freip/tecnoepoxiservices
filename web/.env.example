# Copy to `.env.local` for local development. On Vercel, set these three under
# Project → Settings → Environment Variables instead (never commit real values).

# Resend API key — https://resend.com/api-keys
# Without this the quote form returns an error to the customer rather than
# pretending the request went through, so it is required in production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address.
# Before the domain is verified in Resend, the only address allowed is
# onboarding@resend.dev, and it can ONLY deliver to the email that owns the
# Resend account. After verifying tecnoepoxiservices.com, switch to the line
# below so customer-facing mail carries the company name.
QUOTE_FROM_EMAIL="Tecno Epoxy <quotes@tecnoepoxiservices.com>"

# Where new leads land. Defaults to company.email in src/content/site.ts.
QUOTE_TO_EMAIL=tecnoepoxiflooring@gmail.com

# --- Google Sheet ---
# URL of the Apps Script web app published from the leads spreadsheet
# (see leads-sheet-script.gs at the repo root). Ends in /exec, never /dev.
# Treat it as a password: anyone holding it can append rows.
LEADS_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Optional. Only needed if you add a SHARED_SECRET script property in Apps
# Script; leave unset and the webhook accepts any call to that URL.
LEADS_SHEET_SECRET=
